<!--
  Panda push scene (Phase 1 of BUILD_PLAN.md).

  World frame: origin at the Panda base (panda/link0); +x points away from the robot
  across the table; the tabletop surface is the plane z = 0.

  The Franka Emika Panda is attached unmodified from the pinned MuJoCo Menagerie copy
  (see assets/third_party/mujoco_menagerie/franka_emika_panda.manifest.json, Apache-2.0).
  All Panda element names receive the prefix "panda/".

  Hidden physical parameters (block mass and block/table sliding friction) are written
  by physical_ai_lab.scenario at every reset. The values below are placeholders only.
  Block/table contact is generated exclusively by the explicit <pair> below, so its
  friction is exactly the configured value rather than a geom-combination result.
-->
<mujoco model="panda_push">
  <compiler angle="radian" autolimits="true"/>

  <!-- 0.002 s physics step; the control loop advances exactly 10 steps per 50 Hz update. -->
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="1"/>

  <statistic center="0.35 0 0.25" extent="1.1"/>

  <visual>
    <global offwidth="1280" offheight="960" azimuth="145" elevation="-24"/>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <quality shadowsize="4096"/>
    <!-- shadowclip: see the "key" light below. -->
    <map znear="0.01" shadowclip="2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <model name="panda" file="../third_party/mujoco_menagerie/franka_emika_panda/panda.xml"/>

    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture name="floor" type="2d" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="floor" texture="floor" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <material name="table" rgba="0.72 0.62 0.50 1"/>
    <material name="table_leg" rgba="0.35 0.35 0.38 1"/>
    <material name="block" rgba="0.85 0.22 0.18 1"/>
    <material name="target" rgba="0.10 0.85 0.25 0.55"/>
  </asset>

  <worldbody>
    <!-- A directional light's pos only places its shadow map: MuJoCo draws shadows inside a square of
         half-size statistic extent x visual/map shadowclip (1.1 m x 2) around the light's axis. With the
         default shadowclip of 1 and the axis further back, the floor in the overhead view lay at the edge
         of that square and was speckled with shadow artefacts. The axis now meets the floor at (0.5, 0). -->
    <light name="key" pos="1.05 -0.55 2.0" dir="-0.2 0.2 -1" directional="true" castshadow="true"
      diffuse="0.7 0.7 0.7"/>
    <light name="fill" pos="-0.8 0.8 1.6" dir="0.4 -0.4 -1" directional="true" castshadow="false"
      diffuse="0.25 0.25 0.25"/>

    <geom name="floor" type="plane" pos="0 0 -0.75" size="0 0 0.05" material="floor"/>

    <!-- Robot mounted on the work table; the Panda base frame is the world origin. -->
    <attach model="panda" body="link0" prefix="panda/"/>

    <!-- Table: top surface at z = 0, spanning x in [-0.25, 0.95], y in [-0.5, 0.5]. -->
    <body name="table" pos="0.35 0 0">
      <geom name="table_top" type="box" pos="0 0 -0.02" size="0.6 0.5 0.02" material="table"/>
      <geom name="table_leg_1" type="box" pos="0.55 0.45 -0.39" size="0.025 0.025 0.35" material="table_leg"
        contype="0" conaffinity="0"/>
      <geom name="table_leg_2" type="box" pos="0.55 -0.45 -0.39" size="0.025 0.025 0.35" material="table_leg"
        contype="0" conaffinity="0"/>
      <geom name="table_leg_3" type="box" pos="-0.55 0.45 -0.39" size="0.025 0.025 0.35" material="table_leg"
        contype="0" conaffinity="0"/>
      <geom name="table_leg_4" type="box" pos="-0.55 -0.45 -0.39" size="0.025 0.025 0.35" material="table_leg"
        contype="0" conaffinity="0"/>
    </body>

    <!-- Free 5 cm cube. Inertia is derived from the box geometry (solid cube). -->
    <body name="block" pos="0.52 0 0.025">
      <freejoint name="block_free"/>
      <geom name="block" type="box" size="0.025 0.025 0.025" material="block" mass="0.25"/>
    </body>

    <!-- Goal marker (visual only). Disc radius = 20 mm success tolerance on the block centre. -->
    <body name="target" mocap="true" pos="0.62 0.12 0">
      <geom name="target_zone" type="cylinder" size="0.02 0.0005" pos="0 0 0.0006" material="target"
        contype="0" conaffinity="0" group="1"/>
      <geom name="target_pole" type="cylinder" size="0.0015 0.04" pos="0 0 0.04" material="target"
        contype="0" conaffinity="0" group="1"/>
      <site name="target_center" type="sphere" size="0.003" rgba="0.1 0.85 0.25 1" group="1"/>
    </body>

    <!-- "overhead" looks down at 60 degrees from the far side of the table (from +x, 1.6 m from the point
         (0.45, 0, 0); the robot is at the top of the image). In its home pose the arm hovers over the work
         area, so a straight-down camera lost up to 100% of the block or the goal disc in some layouts.
         From here the arm hides neither anywhere in the reset regions (it starts to above ~65 degrees).
         The smoke test and tests/test_render.py measure this with segmentation renders. -->
    <body name="camera_target" pos="0.42 0 0.12"/>
    <camera name="overhead" pos="1.25 0 1.385641" xyaxes="0 1 0 -0.866025 0 0.5" fovy="45"/>
    <camera name="oblique" pos="1.45 -1.0 0.85" mode="targetbody" target="camera_target" fovy="40"/>
  </worldbody>

  <contact>
    <!-- V1 pushes with the gripper closed (both finger joints at their 0 limit), where the two
         finger pads touch at zero distance. Their mutual contact would only flicker on and off
         numerically; the joint limits already stop the fingers, so the contact is excluded. -->
    <exclude body1="panda/left_finger" body2="panda/right_finger"/>
    <exclude body1="table" body2="block"/>
    <pair name="block_table" geom1="block" geom2="table_top" condim="3" friction="0.5 0.5 0.005 0.0001 0.0001"/>
  </contact>
</mujoco>
